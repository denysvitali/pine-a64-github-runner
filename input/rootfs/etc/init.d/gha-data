#!/sbin/openrc-run
# Mounts and prepares the persistent /data tree.

description="Prepare persistent /data for pine-a64-gh-runner"

depend() {
    need localmount seedrng
    after bootmisc
}

start() {
    ebegin "Preparing /data"
    install -d -m 755 /data
    install -d -m 700 -o root -g root /data/conf
    install -d -m 750 -o 1001 -g 1001 /data/runner
    install -d -m 700 -o 1001 -g 1001 /data/runner/config
    install -d -m 755 /data/log /data/cache

    if [ ! -f /data/conf/env.example ]; then
        cat > /data/conf/env.example <<'EOF'
# Normally generated by `doas gha-setup`. Manual form:
GITHUB_URL=https://github.com/OWNER/REPO
RUNNER_LABELS=pine64,aarch64,self-hosted
RUNNER_NAME=gha-pine64
RUNNER_NAME_SET=1
# Put the short-lived token from GitHub's New self-hosted runner page in
# /data/conf/registration-token (root-owned, mode 600).
EOF
        chmod 600 /data/conf/env.example
    fi

    # The immutable system slot is reset on reboot. Re-apply the persistent
    # onboarding state (key, local password hash, and SSH auth policy) each boot.
    /usr/local/sbin/gha-apply-auth-state || return 1
    eend 0
}
