# --- Target ---
DEFAULT_HOSTNAME=gha-pine64
ARCH=aarch64
ALPINE_BRANCH=v3.22
# Board profile: plain (Pine A64, non-plus) | plus (Pine A64+ 1/2GB) | lts (A64-LTS/SoPine)
# Picks the U-Boot binary and kernel DTB together; see scripts/40-image.sh.
BOARD=plain

# --- Image layout (MB) ---
# BOOT holds Image+initramfs+dtbs twice (A/B); the immutable+kms initramfs
# alone is ~80MB. 40-image.sh auto-bumps if staged assets outgrow this.
SIZE_BOOT=384
# Each A/B slot holds: Alpine rootfs + Debian chroot + actions-runner (~1.7GB)
SIZE_SLOT=2048
# DATA partition takes the rest of the image (>= BOOT + 2*SLOT + 512)
SIZE_IMAGE=4800

# Kernel cmdline extras (immutable root via stock mkinitfs overlaytmpfs)
CMDLINE=console=tty0 console=ttyS0,115200 quiet rootfstype=ext4 rootwait ro modules=overlay panic=5
ROOT_OVERLAY_SIZE=256M
CHROOT_OVERLAY_SIZE=512M

# --- GitHub Actions runner ---
# "latest" or an exact version, e.g. 2.336.0
RUNNER_VERSION=latest

# --- Networking ---
WIFI_ENABLED=false
WIFI_SSID=
WIFI_PSK=

# --- Misc ---
ALPINE_MIRROR=https://dl-cdn.alpinelinux.org/alpine
CHROOT_DISTRO=bookworm
CACHE_PATH=/input/build_cache
